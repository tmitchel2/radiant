<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Radiant.PlatformCheck</RootNamespace>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- A window for checking the platform layer by hand (input methods, cursors, appearance,
       clipboard, dialogs), and with the selftest flag an automated check of text input against GLFW's
       real content view. See docs/platform.md. -->
  <ItemGroup>
    <ProjectReference Include="..\Radiant.Components\Radiant.Components.csproj" />
    <ProjectReference Include="..\Radiant.Platform.MacOS\Radiant.Platform.MacOS.csproj" />
  </ItemGroup>

</Project>
