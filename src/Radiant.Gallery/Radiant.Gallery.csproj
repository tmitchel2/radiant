<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Radiant.Gallery</RootNamespace>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Published ahead of time: `dotnet publish -c Release -r osx-arm64`. Also turns on the
         trimming and AOT analysers for every build, so code that wouldn't survive it is caught. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <Import Project="..\Directory.Publish.props" />

  <ItemGroup>
    <ProjectReference Include="..\Radiant.Templates\Radiant.Templates.csproj" />
    <ProjectReference Include="..\Radiant.Platform.MacOS\Radiant.Platform.MacOS.csproj" />
    <ProjectReference Include="..\Radiant.Generators\Radiant.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
