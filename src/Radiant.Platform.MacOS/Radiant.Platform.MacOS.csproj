<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Radiant.Platform.MacOS</RootNamespace>
    <OutputType>Library</OutputType>
    <DebugType>embedded</DebugType>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Radiant.Platform.MacOS.Tests" />
    <InternalsVisibleTo Include="PlatformCheck" />
  </ItemGroup>

  <!-- AppKit through the Objective-C runtime, with no binding library: it depends only on the
       platform interfaces, never on the UI, so the UI can't end up depending on macOS. -->
  <ItemGroup>
    <ProjectReference Include="..\Radiant.Platform\Radiant.Platform.csproj" />
  </ItemGroup>

</Project>
