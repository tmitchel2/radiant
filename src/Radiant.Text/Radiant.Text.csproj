<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Radiant.Text</RootNamespace>
    <OutputType>Library</OutputType>
    <DebugType>embedded</DebugType>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Radiant.Text.Tests" />
  </ItemGroup>

  <!-- Variable Inter, JetBrains Mono and Source Serif 4 (SIL Open Font License), Material Symbols
       (Apache-2.0) and Lucide's outline icons (ISC), with the map from icon names to Lucide's glyphs;
       licences alongside. -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="Radiant.Text.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fonts\OutlineIcons.map" LogicalName="Radiant.Text.Fonts.OutlineIcons.map" />
  </ItemGroup>

  <ItemGroup>
    <!-- HarfBuzz (MIT): shaping, variable fonts, glyph outlines. -->
    <PackageReference Include="HarfBuzzSharp" Version="14.2.1.201" />
  </ItemGroup>

</Project>
