<Project Sdk="Microsoft.NET.Sdk">

  <!-- The test SDK: drive a Radiant UI app from any test framework, in-process (fast, on a fixed
       clock) or a real app process over the agent protocol's socket or file transport. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Radiant.UI.Driver</RootNamespace>
    <OutputType>Library</OutputType>
    <DebugType>embedded</DebugType>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Radiant.UI.Driver.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Radiant.UI.Automation\Radiant.UI.Automation.csproj" />
  </ItemGroup>

</Project>
